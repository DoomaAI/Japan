DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Exact deployed HTTPS origin, no trailing slash.
APP_ORIGIN=
# Optional. Switches on the Claude-powered features, including reading forwarded email.
ANTHROPIC_API_KEY=
# Optional. Forwarded email: the secret your mail provider puts in the webhook URL, and the
# addresses allowed to forward — or a single * for any sender. Both are required before
# /api/email-in accepts anything, and an empty sender list means nobody rather than everybody.
EMAIL_INBOX_SECRET=
EMAIL_INBOX_SENDERS=
